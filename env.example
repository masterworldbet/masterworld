# Meta Pixel ID from Meta Events Manager (public browser-side ID)
NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID

# Direct LINE OA / LINE registration URL
NEXT_PUBLIC_LINE_URL=https://line.me/

# Server-only Supabase settings. Never use NEXT_PUBLIC_ for these secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Admin login/session secrets. Use unique, strong values in Vercel.
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
